[Unit]
Description=Host load dashboard for the Waveshare ESP32-S3-RLCD-4.2
Documentation=@RLCD_DOC@
After=multi-user.target
# never give up restarting
StartLimitIntervalSec=0

[Service]
Type=simple
User=@RLCD_USER@
# The board's tty is root:dialout 0660.  Joining the group lets the service work
# without a udev rule and without touching the login user's groups.
SupplementaryGroups=dialout
# --wait 0: keep retrying if the board is not enumerated yet (boot ordering is
# not guaranteed) or gets unplugged later.
ExecStart=@RLCD_BIN@ --port @RLCD_PORT@ --hz @RLCD_HZ@ --wait 0
Restart=always
RestartSec=3

# The program only reads /proc, /sys and the serial device, and writes to its
# stdout (captured by the journal).  It needs no privileges at all.
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=read-only
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
CapabilityBoundingSet=
AmbientCapabilities=

[Install]
WantedBy=multi-user.target
